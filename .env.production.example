# Copy this file to .env on EC2.
# Do not commit real production secrets.

DOCKERHUB_USERNAME=your-dockerhub-user
IMAGE_TAG=latest

VITE_API_URL=/api
APP_FRONTEND_URL=http://your-ec2-public-ip
APP_TIME_ZONE=Europe/Stockholm
APP_INVOICE_REMINDERS_CRON=0 0 9 * * *
APP_TEST_DATA_RESET_ENABLED=false
APP_BANK_RECONCILIATION_RESET_ENABLED=false
APP_CORS_ALLOWED_ORIGINS=http://your-ec2-public-ip
APP_CORS_LOCAL_DEV_ENABLED=false
APP_AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
APP_AUTH_LOGIN_LOCK_MINUTES=15
APP_AUTH_REGISTRATION_BOOTSTRAP_KEY=replace_with_one_time_owner_setup_key_32_chars

SPRING_DATASOURCE_URL=jdbc:postgresql://your-rds-endpoint.eu-north-1.rds.amazonaws.com:5432/cloudshop
SPRING_DATASOURCE_USERNAME=cloudshop
SPRING_DATASOURCE_PASSWORD=replace_with_rds_password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
APP_SCHEMA_PATCH_ENABLED=false
APP_MONEY_MIGRATION_VERIFY_ON_STARTUP=true
APP_MONEY_MIGRATION_FULL_CHECK_CRON=0 0 2 * * *
APP_MONEY_MIGRATION_MAX_FULL_CHECK_AGE_HOURS=26
APP_MONEY_MIGRATION_AUTHORITATIVE=false

JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRATION_MINUTES=60

STRIPE_SECRET_KEY=sk_test_or_live_key
STRIPE_WEBHOOK_SECRET=whsec_from_stripe

GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
HF_TOKEN=hf_...
HF_MODEL=moonshotai/Kimi-K2-Instruct-0905
HF_BASE_URL=https://router.huggingface.co/v1
AI_OPENAI_API_KEY=your-router-or-provider-key
AI_OPENAI_MODEL=moonshotai/Kimi-K2-Instruct-0905
AI_OPENAI_BASE_URL=https://your-openai-compatible-router.example/v1
AI_OPENAI_PROVIDER_NAME=openai-compatible

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=google-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
