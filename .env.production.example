# Copy this file to .env on EC2.
# Do not commit real production secrets.

DOCKERHUB_USERNAME=your-dockerhub-user
IMAGE_TAG=latest

VITE_API_URL=/api
# Use the HTTPS hostname covered by the production TLS certificate.
APP_FRONTEND_URL=https://books.your-domain.example
TLS_CERT_HOST_PATH=/etc/letsencrypt/live/books.your-domain.example/fullchain.pem
TLS_KEY_HOST_PATH=/etc/letsencrypt/live/books.your-domain.example/privkey.pem
APP_TIME_ZONE=Europe/Stockholm
APP_INVOICE_REMINDERS_CRON=0 0 9 * * *
APP_TEST_DATA_RESET_ENABLED=false
APP_BANK_RECONCILIATION_RESET_ENABLED=false
APP_CORS_ALLOWED_ORIGINS=https://books.your-domain.example
APP_CORS_LOCAL_DEV_ENABLED=false
APP_AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
APP_AUTH_LOGIN_LOCK_MINUTES=15
APP_AUTH_REGISTRATION_BOOTSTRAP_KEY=replace_with_one_time_owner_setup_key_32_chars
APP_AUTH_MFA_ENCRYPTION_KEY=replace_with_base64_encoded_random_32_byte_key
APP_AUTH_REQUIRE_MFA=true

# Install the current AWS RDS CA bundle at this host path before deployment.
RDS_CA_CERT_HOST_PATH=/opt/alibooks/certs/global-bundle.pem
SPRING_DATASOURCE_URL=jdbc:postgresql://your-rds-endpoint.eu-north-1.rds.amazonaws.com:5432/cloudshop?sslmode=verify-full&sslrootcert=/run/certs/rds-ca-bundle.pem
SPRING_DATASOURCE_USERNAME=alibooks_app
SPRING_DATASOURCE_PASSWORD=replace_with_rds_password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
APP_SCHEMA_PATCH_ENABLED=false
APP_MONEY_MIGRATION_VERIFY_ON_STARTUP=true
APP_MONEY_MIGRATION_FULL_CHECK_CRON=0 0 2 * * *
APP_MONEY_MIGRATION_MAX_FULL_CHECK_AGE_HOURS=26

JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRATION_MINUTES=60

STRIPE_SECRET_KEY=sk_test_or_live_key
STRIPE_WEBHOOK_SECRET=whsec_from_stripe

GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
HF_TOKEN=hf_...
HF_MODEL=moonshotai/Kimi-K2-Instruct-0905
HF_BASE_URL=https://router.huggingface.co/v1
AI_OPENAI_API_KEY=your-router-or-provider-key
AI_OPENAI_MODEL=moonshotai/Kimi-K2-Instruct-0905
AI_OPENAI_BASE_URL=https://your-openai-compatible-router.example/v1
AI_OPENAI_PROVIDER_NAME=openai-compatible

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=google-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_SMTP_CHECK_SERVER_IDENTITY=true
SPRING_MAIL_CONNECTION_TIMEOUT_MS=5000
SPRING_MAIL_READ_TIMEOUT_MS=10000
SPRING_MAIL_WRITE_TIMEOUT_MS=10000
